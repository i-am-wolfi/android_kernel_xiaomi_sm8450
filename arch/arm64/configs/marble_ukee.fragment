# marble (Poco F5 / Redmi Note 12 Turbo) + ukee (SM7475) sobre waipio (SM8450)
# Base: ltdq lineage-24.0 (6.11 / android16-6.12) + ACK
# Build: make direto + clang, SEM LTO (mais rapido que thin-LTO p/ compilar)
CONFIG_ARCH_WAIPIO=y
CONFIG_ARCH_DIWALI=y
CONFIG_LOCALVERSION="-marble-ukee-6.12"
# Sem LTO nos builds de teste (link LTO e lento); ligar so no final se preciso
CONFIG_LTO_NONE=y
# CONFIG_LTO_CLANG_THIN is not set
# CONFIG_LTO_CLANG_FULL is not set
CONFIG_MHI_BUS_MISC=y
CONFIG_REGMAP=y
CONFIG_INTERCONNECT=y
CONFIG_INPUT=y
CONFIG_IIO=y
CONFIG_PINCTRL=y
CONFIG_THERMAL=y
CONFIG_DMA_SHARED_BUFFER=y
CONFIG_UIO=y
CONFIG_CPU_IDLE=y
CONFIG_USB_GADGET=y
CONFIG_USB_SUPPORT=y
CONFIG_MMC=y
CONFIG_GENERIC_PHY=y
CONFIG_QCOM_IOMMU_UTIL=y
CONFIG_PHY_QCOM_UFS=y
CONFIG_PHY_QCOM_UFS_V4=y
CONFIG_PHY_QCOM_UFS_V4_CAPE=y
CONFIG_PHY_QCOM_SNPS_EUSB2=y
CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_QMP_USB=y
CONFIG_MTDOOPS=y
# CONFIG_PHY_QCOM_QMP_COMBO is not set
# CONFIG_PHY_QCOM_QMP_UFS is not set
# CONFIG_PHY_QCOM_QMP_PCIE is not set
# CONFIG_PHY_QCOM_QMP_PCIE_8996 is not set
# CONFIG_DEBUG_INFO_BTF is not set
# CONFIG_DEBUG_INFO_BTF_MODULES is not set
# CONFIG_KVM is not set
# CONFIG_ARM_SMMU_V3_PKVM is not set
# CONFIG_IKCONFIG is not set
# CONFIG_IKCONFIG_PROC is not set
# CONFIG_KHEADERS is not set
# CONFIG_IKHEADERS is not set
CONFIG_ARM_SMMU=y
# CONFIG_QCOM_SMMU_V2_V3_DISPATCHER is not set
# Touchscreen upstream equivalentes (drivers xiaomi 5.10 em xiaomi-backport/ p/ porte futuro)
CONFIG_TOUCHSCREEN_GOODIX=m
CONFIG_TOUCHSCREEN_GOODIX_BERLIN_I2C=m
CONFIG_TOUCHSCREEN_GOODIX_BERLIN_SPI=m
# Rede / power (de marble_GKI.config + xiaomi_GKI.config, quando existirem no 6.11)
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BBR=y
CONFIG_TCP_CONG_WESTWOOD=y
CONFIG_DEFAULT_WESTWOOD=y
CONFIG_BUILD_ARM64_DT_OVERLAY=y
# CONFIG_QCOM_SPSS is not set
# CONFIG_RPMSG_QCOM_GLINK_SPSS is not set
